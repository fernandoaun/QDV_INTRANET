# =============================================================================
# OpenClaw + WhatsApp (gateway nativo). Copiar a ".env" en esta carpeta.
#   copy .env.example .env
# NUNCA subas este archivo con valores reales. NUNCA definas DATABASE_URL aquí.
# =============================================================================

# Token del dashboard de OpenClaw (obligatorio). Generar:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OPENCLAW_GATEWAY_TOKEN=cambiá-este-valor

# URL pública de QDV (sin barra final).
# Local (QDV en la PC, OpenClaw en Docker):
QDV_API_BASE_URL=http://host.docker.internal:5000
# Render:
# QDV_API_BASE_URL=https://qdv-salmuera-web.onrender.com

# Mismo valor que API_BEARER_TOKEN en el Environment de QDV.
QDV_API_BEARER_TOKEN=cambiá-este-token

# Allowlist del gateway (quién puede hablarle al bot). No alcanza con esto:
# cada número tiene que estar en un usuario QDV (Admin → WhatsApp).
# Ejemplo Argentina: +54911XXXXXXXX,+549351XXXXXXX
QDV_WHATSAPP_ALLOW_FROM=+54911XXXXXXXX

# Al menos UNA clave de modelo (el dashboard también las puede guardar).
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Modelo opcional (si está vacío, se configura desde el dashboard de OpenClaw).
# OPENCLAW_MODEL=openrouter/anthropic/claude-sonnet-4.6

# Puerto local del gateway / Control UI.
OPENCLAW_GATEWAY_PORT=18789

# Zona horaria de planta.
TZ=America/Argentina/Buenos_Aires
OPENCLAW_TZ=America/Argentina/Buenos_Aires
